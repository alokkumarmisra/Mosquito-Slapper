# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_BACKEND_API_URL: Optional default custom Backend API base URL pre-populated in Settings
# (e.g. "https://api.example.com" or "http://192.168.1.50:3000"). Leave blank to use the built-in server.
VITE_BACKEND_API_URL=""

# BACKEND_API_TOKEN: Optional server-side Bearer token attached automatically by /api/backend/proxy
# when forwarding requests to a custom Backend API that requires authentication.
BACKEND_API_TOKEN=""

# Optional custom direct store or binary installer URLs (APK, App Store/TestFlight, EXE/MSIX).
# When blank, the built-in PWA installers, Apple .mobileconfig/.command, and Windows .cmd/.url downloads are used.
VITE_ANDROID_DOWNLOAD_URL=""
VITE_APPLE_DOWNLOAD_URL=""
VITE_WINDOWS_DOWNLOAD_URL=""

